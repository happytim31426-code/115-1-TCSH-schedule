rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && request.auth.token.firebase.sign_in_provider == 'google.com';
    }
    function selfEmail() { return request.auth.token.email; }
    function member() {
      return signedIn()
        && exists(/databases/$(database)/documents/members/$(selfEmail()))
        && get(/databases/$(database)/documents/members/$(selfEmail())).data.active == true
        && get(/databases/$(database)/documents/members/$(selfEmail())).data.role in ['admin', 'teacher'];
    }
    function admin() {
      return member() && get(/databases/$(database)/documents/members/$(selfEmail())).data.role == 'admin';
    }
    match /members/{email} {
      allow get: if signedIn() && (email == selfEmail() || admin());
      allow list: if admin();
      allow create, update: if admin()
        && email != selfEmail()
        && request.resource.data.keys().hasAll(['name', 'role', 'active', 'updatedAt', 'updatedBy'])
        && request.resource.data.keys().hasOnly(['name', 'role', 'active', 'updatedAt', 'updatedBy'])
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0 && request.resource.data.name.size() <= 80
        && request.resource.data.role in ['admin', 'teacher', 'patrol', 'exam']
        && request.resource.data.active is bool
        && request.resource.data.updatedAt == request.time
        && request.resource.data.updatedBy == request.auth.uid;
      allow delete: if false;
    }
    match /recruitmentPlans/{id} {
      allow read: if member();
      allow create, update: if member()
        && id == request.auth.uid + '_' + string(request.resource.data.week) + '_' + string(request.resource.data.day)
        && request.resource.data.keys().hasAll(['day', 'plans', 'updatedAt', 'updatedBy'])
        && request.resource.data.keys().hasOnly(['week','day', 'plans', 'updatedAt', 'updatedBy'])
        && request.resource.data.week is int && request.resource.data.week >= 1 && request.resource.data.week <= 21
        && request.resource.data.day is int
        && request.resource.data.day >= 0 && request.resource.data.day <= 4
        && request.resource.data.plans is list
        && request.resource.data.plans.size() >= 1 && request.resource.data.plans.size() <= 5
        && request.resource.data.updatedAt == request.time
        && request.resource.data.updatedBy == request.auth.uid;
      allow delete: if false;
    }
    function versioned(collection, id) {
      return request.resource.data.updatedBy == request.auth.uid
        && request.resource.data.updatedName == get(/databases/$(database)/documents/members/$(selfEmail())).data.name
        && request.resource.data.createdName is string && request.resource.data.createdName.size() <= 80
        && request.resource.data.createdBy is string && request.resource.data.createdAt is timestamp
        && request.resource.data.updatedAt == request.time
        && request.resource.data.revision is int
        && ((!exists(/databases/$(database)/documents/$(collection)/$(id)) && request.resource.data.revision == 1
            && request.resource.data.createdBy == request.auth.uid && request.resource.data.createdName == request.resource.data.updatedName && request.resource.data.createdAt == request.time)
          || (exists(/databases/$(database)/documents/$(collection)/$(id)) && request.resource.data.revision == resource.data.revision + 1
            && (!resource.data.keys().hasAll(['createdName','createdBy','createdAt']) || (request.resource.data.createdName == resource.data.createdName && request.resource.data.createdBy == resource.data.createdBy && request.resource.data.createdAt == resource.data.createdAt))));
    }
    function validDate(date) { return date is string && date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$') && date >= '2026-08-31' && date <= '2027-01-20'; }
    function examMember() {
      return signedIn()
        && exists(/databases/$(database)/documents/members/$(selfEmail()))
        && get(/databases/$(database)/documents/members/$(selfEmail())).data.active == true
        && get(/databases/$(database)/documents/members/$(selfEmail())).data.role in ['admin', 'exam'];
    }
    match /examSettings/{id} {
      allow read: if examMember();
      allow create, update: if examMember()
        && id in ['first','second','third']
        && request.resource.data.keys().hasAll(['category','dates','revision','createdAt','createdBy','createdName','updatedAt','updatedBy','updatedName'])
        && request.resource.data.keys().hasOnly(['category','dates','revision','createdAt','createdBy','createdName','updatedAt','updatedBy','updatedName'])
        && request.resource.data.category == id
        && request.resource.data.dates is list && request.resource.data.dates.size() == 3
        && validDate(request.resource.data.dates[0]) && validDate(request.resource.data.dates[1]) && validDate(request.resource.data.dates[2])
        && request.resource.data.dates[0] < request.resource.data.dates[1]
        && request.resource.data.dates[1] < request.resource.data.dates[2]
        && versioned('examSettings', id);
      allow delete: if false;
    }
    function slot(s) {
      return s is map && s.keys().hasOnly(['teacher','date','row','classId','subject'])
        && s.teacher is string && s.teacher.size() > 0 && s.teacher.size() <= 80 && validDate(s.date)
        && s.row is int && s.row >= 1 && s.row <= 8 && s.classId is string && s.subject is string && s.subject.size() <= 160;
    }
    function course(r) {
      return r.kind in ['leave','sub','swap']
        && (r.kind == 'leave' ? (r.a.keys().hasOnly(['teacher','date']) && r.a.teacher is string && validDate(r.a.date) && r.b == null)
          : (slot(r.a) && (r.kind == 'swap' ? slot(r.b) : (r.b.keys().hasOnly(['teacher','date','row']) && r.b.teacher is string && validDate(r.b.date) && r.b.row == r.a.row))));
    }
    match /recruitmentRecords/{id} {
      allow read: if member();
      allow create, update: if member() && versioned('recruitmentRecords', id)
        && request.resource.data.keys().hasOnly(['week','day','date','plans','status','revision','updatedAt','updatedBy','updatedName','createdName','createdBy','createdAt'])
        && id == request.resource.data.date && validDate(id)
        && request.resource.data.week is int && request.resource.data.week >= 1 && request.resource.data.week <= 21
        && request.resource.data.day is int && request.resource.data.day >= 0 && request.resource.data.day <= 4
        && request.resource.data.plans is list && request.resource.data.plans.size() >= 1 && request.resource.data.plans.size() <= 5
        && request.resource.data.status in ['submitted','returned','cancelled','deleted'];
      allow delete: if false;
    }
    match /courseRecords/{id} {
      allow read: if member();
      allow create, update: if member() && versioned('courseRecords', id) && course(request.resource.data)
        && request.resource.data.keys().hasOnly(['kind','a','b','leaveType','leaveRange','note','order','status','revision','updatedAt','updatedBy','updatedName','createdName','createdBy','createdAt'])
        && privateLeaveWindow(request.resource.data)
        && request.resource.data.leaveType in ['','公假','差假','公差假','婚假','產(檢)假','喪假','病假','事假','重大假別','其他']
        && request.resource.data.note is string && request.resource.data.note.size() <= 300
        && request.resource.data.order is number && request.resource.data.status in ['submitted','cancelled','deleted'];
      allow delete: if false;
    }
    function privateLeaveWindow(r) {
      return !r.keys().hasAny(['leaveRange']) || (r.leaveRange is map
        && r.leaveRange.keys().hasAll(['mode','start','end'])
        && r.leaveRange.keys().hasOnly(['mode','start','end'])
        && r.leaveRange.mode in ['all','am','pm','custom']
        && r.leaveRange.start is int && r.leaveRange.end is int
        && r.leaveRange.start >= 1 && r.leaveRange.end <= 8 && r.leaveRange.start <= r.leaveRange.end
        && (r.leaveRange.mode == 'custom'
          || (r.leaveRange.mode == 'all' && r.leaveRange.start == 1 && r.leaveRange.end == 8)
          || (r.leaveRange.mode == 'am' && r.leaveRange.start == 1 && r.leaveRange.end == 4)
          || (r.leaveRange.mode == 'pm' && r.leaveRange.start == 5 && r.leaveRange.end == 8)));
    }
    match /publicRecruitments/{id} {
      allow read: if true;
      allow create, update: if member()
        && request.resource.data.keys().hasOnly(['date','people']) && request.resource.data.date == id && validDate(id)
        && request.resource.data.people is list && request.resource.data.people.size() <= 100
        && getAfter(/databases/$(database)/documents/recruitmentRecords/$(id)).data.status in ['submitted','returned','cancelled'];
      allow delete: if member();
    }
    match /publicCourseRecords/{id} {
      allow read: if true;
      allow create, update: if member() && course(request.resource.data)
        && request.resource.data.keys().hasOnly(['id','kind','a','b','leaveCode','order'])
        && request.resource.data.id == id && request.resource.data.leaveCode in ['','假']
        && request.resource.data.order is number
        && getAfter(/databases/$(database)/documents/courseRecords/$(id)).data.status == 'submitted';
      allow delete: if member();
    }
    function eventFields(r) {
      return r.week is int && r.week >= 1 && r.week <= 21
        && r.name is string && r.name.size() > 0 && r.name.size() <= 80
        && r.effect in ['blocked','no-class']
        && r.startDay is int && r.startDay >= 0 && r.startDay <= 4
        && r.endDay is int && r.endDay >= 0 && r.endDay <= 4
        && r.startRow is int && r.startRow >= 1 && r.startRow <= 8
        && r.endRow is int && r.endRow >= 1 && r.endRow <= 8
        && r.startDay * 8 + r.startRow <= r.endDay * 8 + r.endRow
        && r.startClass is string && r.endClass is string
        && (!r.keys().hasAny(['absentTeachers']) || (r.absentTeachers is list && r.absentTeachers.size() <= 120));
    }
    match /schoolEvents/{id} {
      allow read: if member();
      allow create, update: if member() && versioned('schoolEvents',id) && eventFields(request.resource.data)
        && request.resource.data.keys().hasOnly(['week','name','effect','startDay','startRow','endDay','endRow','startClass','endClass','absentTeachers','teacherGroups','otherTeachers','status','revision','updatedAt','updatedBy','updatedName','createdName','createdBy','createdAt'])
        && (!request.resource.data.keys().hasAny(['teacherGroups']) || (request.resource.data.teacherGroups is list && request.resource.data.teacherGroups.size() <= 6 && request.resource.data.teacherGroups.hasOnly(['國一','國二','國三','高一','高二','高三'])))
        && (!request.resource.data.keys().hasAny(['otherTeachers']) || (request.resource.data.otherTeachers is list && request.resource.data.otherTeachers.size() <= 120))
        && request.resource.data.status in ['submitted','deleted'];
      allow delete: if false;
    }
    match /publicSchoolEvents/{id} {
      allow read: if true;
      allow create, update: if member() && eventFields(request.resource.data)
        && request.resource.data.keys().hasOnly(['week','name','effect','startDay','startRow','endDay','endRow','startClass','endClass','absentTeachers'])
        && getAfter(/databases/$(database)/documents/schoolEvents/$(id)).data.status == 'submitted';
      allow delete: if member();
    }
    function patrolUser() {
      return signedIn()
        && exists(/databases/$(database)/documents/members/$(selfEmail()))
        && get(/databases/$(database)/documents/members/$(selfEmail())).data.active == true
        && get(/databases/$(database)/documents/members/$(selfEmail())).data.role == 'patrol';
    }
    match /patrolRecords/{id} {
      allow get: if admin() || (patrolUser() && (!exists(/databases/$(database)/documents/patrolRecords/$(id)) || resource.data.createdBy == request.auth.uid));
      allow list: if admin() || (patrolUser() && resource.data.createdBy == request.auth.uid);
      allow create: if (admin() || patrolUser()) && patrolFields(id)
        && request.resource.data.status == 'submitted';
      allow update: if (admin() || (patrolUser() && resource.data.createdBy == request.auth.uid)) && patrolFields(id)
        && request.resource.data.date == resource.data.date && request.resource.data.week == resource.data.week
        && request.resource.data.period == resource.data.period && request.resource.data.classId == resource.data.classId
        && request.resource.data.className == resource.data.className && request.resource.data.grade == resource.data.grade
        && request.resource.data.lessons == resource.data.lessons
        && request.resource.data.get('observerName','') == resource.data.get('observerName','')
        && request.resource.data.get('origin',null) == resource.data.get('origin',null);
      allow delete: if false;
    }
    function patrolLesson(list, index) {
      return list.size() <= index || (list[index] is map
        && list[index].keys().hasAll(['teacher','subject']) && list[index].keys().hasOnly(['teacher','subject'])
        && list[index].teacher is string && list[index].teacher.size() <= 80
        && list[index].subject is string && list[index].subject.size() <= 160);
    }
    function patrolFields(id) {
      let r = request.resource.data;
      return versioned('patrolRecords',id)
        && r.keys().hasAll(['date','week','period','classId','className','grade','lessons','result','issues','note','status'])
        && r.keys().hasOnly(['date','week','period','classId','className','grade','lessons','result','issues','note','status','observerName','origin','revision','createdBy','createdName','createdAt','updatedBy','updatedName','updatedAt'])
        && (!r.keys().hasAny(['observerName','origin']) || (admin()
          && r.keys().hasAll(['observerName','origin'])
          && r.observerName is string && r.observerName.size() > 0 && r.observerName.size() <= 80
          && r.origin is map && r.origin.keys().hasAll(['kind','documentId','gid','row']) && r.origin.keys().hasOnly(['kind','documentId','gid','row'])
          && r.origin.kind in ['manual','csv'] && r.origin.documentId is string && r.origin.documentId.size() <= 120
          && r.origin.gid is string && r.origin.gid.size() <= 30 && r.origin.row is int
          && (r.origin.kind == 'manual' ? (r.origin.documentId == '' && r.origin.gid == '' && r.origin.row == 0)
            : (r.origin.documentId.matches('^[A-Za-z0-9_-]+$') && r.origin.gid.matches('^[0-9]+$') && r.origin.row >= 2))))
        && validDate(r.date) && r.week is int && r.week >= 1 && r.week <= 21
        && r.period is int && r.period >= 1 && r.period <= 8
        && r.classId is string && r.classId.size() > 0 && r.classId.size() <= 40
        && r.className is string && r.className.size() <= 40
        && r.grade in ['國一','國二','國三','高一','高二','高三']
        && r.lessons is list && r.lessons.size() <= 12
        && patrolLesson(r.lessons,0) && patrolLesson(r.lessons,1) && patrolLesson(r.lessons,2)
        && patrolLesson(r.lessons,3) && patrolLesson(r.lessons,4) && patrolLesson(r.lessons,5)
        && patrolLesson(r.lessons,6) && patrolLesson(r.lessons,7) && patrolLesson(r.lessons,8)
        && patrolLesson(r.lessons,9) && patrolLesson(r.lessons,10) && patrolLesson(r.lessons,11)
        && r.result in ['normal','issue'] && r.issues is list && r.issues.size() <= 9
        && r.issues.hasOnly(['師生音量需控管','學生趴睡需提醒','3C使用管理待提升','老師遲到/缺課','師生互動待提升','桌椅未靠攏','外堂課門窗未關','電燈、電扇未關','外堂課電視未關'])
        && r.note is string && r.note.size() <= 500
        && (r.result == 'issue' ? (r.issues.size() > 0 || r.note.size() > 0) : r.issues.size() == 0)
        && r.status in ['submitted','deleted'];
    }
    // Photo uploads remain disabled.
    match /{document=**} { allow read, write: if false; }
  }
}
